model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  img         String?
  classId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("events")
}
