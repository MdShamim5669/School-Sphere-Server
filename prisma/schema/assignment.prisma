model Assignment {
  id        String   @id @default(uuid())
  title     String
  startDate DateTime
  dueDate   DateTime
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  results Result[]

  @@map("assignments")
}
