model Parent {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  students  Student[]

  @@map("parents")
}
